Функция ОтправитьЗапрос(ТекстЗапроса) Экспорт
	
	APIКлюч =
		Константы.YandexGPTAPIКлюч.Получить();
	
	FolderID =
		Константы.YandexFolderID.Получить();
	
	Если ПустаяСтрока(APIКлюч) Тогда
		Возврат "Не заполнен API ключ YandexGPT";
	КонецЕсли;
	
	ТелоЗапроса = Новый Структура;
	
	ТелоЗапроса.Вставить(
		"modelUri",
		"gpt://" + FolderID + "/yandexgpt-lite/latest"
	);
	
	Параметры = Новый Структура;
	Параметры.Вставить("temperature", 0.3);
	Параметры.Вставить("maxTokens", 2000);
	
	ТелоЗапроса.Вставить(
		"completionOptions",
		Параметры
	);
	
	МассивСообщений = Новый Массив;
	
	Системное =
		Новый Структура;
	
	Системное.Вставить(
		"role",
		"system"
	);
	
	Системное.Вставить(
		"text",
		"Ты технолог молочного производства и аналитик качества. "
		+ "Анализируй брак молочной продукции, "
		+ "учитывай кислотность, жирность, "
		+ "температурный режим, микробиологические риски "
		+ "и сезонность производства."
		+ "отправь ответ без разметки md"
	);
	
	МассивСообщений.Добавить(Системное);
	
	Пользователь =
		Новый Структура;
	
	Пользователь.Вставить(
		"role",
		"user"
	);
	
	Пользователь.Вставить(
		"text",
		ТекстЗапроса
	);
	
	МассивСообщений.Добавить(Пользователь);
	
	ТелоЗапроса.Вставить(
		"messages",
		МассивСообщений
	);
	
	ЗаписьJSON = Новый ЗаписьJSON;

	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(
		ЗаписьJSON,
		ТелоЗапроса
	);

	СтрокаJSON =
		ЗаписьJSON.Закрыть();

	Соединение =
		Новый HTTPСоединение(
			"llm.api.cloud.yandex.net",
			443,
			,
			,
			,
			60,
			Новый ЗащищенноеСоединениеOpenSSL()
		);
	
	Заголовки = Новый Соответствие;
	
	Заголовки.Вставить(
		"Authorization",
		"Api-Key " + APIКлюч
	);
	
	Заголовки.Вставить(
		"Content-Type",
		"application/json"
	);
	
	ЗапросHTTP =
		Новый HTTPЗапрос(
			"/foundationModels/v1/completion",
			Заголовки
		);
	
	ЗапросHTTP.УстановитьТелоИзСтроки(
		СтрокаJSON,
		КодировкаТекста.UTF8
	);
	
	Попытка
		
		Ответ =
			Соединение
			.ОтправитьДляОбработки(
				ЗапросHTTP
			);
		
	Исключение
		
		Возврат
			"Ошибка подключения: "
			+ ОписаниеОшибки();
		
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		
		Возврат
			"Ошибка API: "
			+ Ответ.КодСостояния;
		
	КонецЕсли;
	
	ТекстОтвета =
		Ответ.ПолучитьТелоКакСтроку(
			КодировкаТекста.UTF8
		);
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
	
	ДанныеОтвета =
		ПрочитатьJSON(ЧтениеJSON);
	
	Попытка
		
		ОтветИИ =
			ДанныеОтвета
			.result
			.alternatives[0]
			.message
			.text;
		
	Исключение
		
		Возврат
			"Ошибка разбора ответа YandexGPT";
		
	КонецПопытки;
	
	Возврат ОтветИИ;
	
КонецФункции

Функция ПолучитьРекомендацииПоБраку(
	Номенклатура,
	РезультатПрогноза
) Экспорт
	
	ТекущийПроцент = 0;
	
	Если РезультатПрогноза.История.ПроцентыБрака.Количество() > 0 Тогда
		
		ТекущийПроцент =
			РезультатПрогноза
			.История
			.ПроцентыБрака[
				РезультатПрогноза
				.История
				.ПроцентыБрака
				.Количество() - 1
			];
		
	КонецЕсли;
	
	БудущийПроцент =
		РезультатПрогноза
		.Прогноз[0]
		.Прогноз;
	
	Текст =
		"Проанализируй ситуацию по браку молочной продукции."
		+ Символы.ПС
		+ Символы.ПС
		+ "Продукция: "
		+ Номенклатура.Наименование
		+ Символы.ПС
		+ "Текущий процент брака: "
		+ Формат(ТекущийПроцент, "ЧГ=0.00")
		+ "%"
		+ Символы.ПС
		+ "Прогноз на следующий месяц: "
		+ Формат(БудущийПроцент, "ЧГ=0.00")
		+ "%"
		+ Символы.ПС
		+ "Тренд: "
		+ РезультатПрогноза.Тренд
		+ Символы.ПС
		+ "Достоверность модели R2: "
		+ Формат(
			РезультатПрогноза.R2 * 100,
			"ЧГ=0.00"
		)
		+ "%"
		+ Символы.ПС
		+ Символы.ПС
		+ "Дай:"
		+ Символы.ПС
		+ "1. Причины роста или снижения брака"
		+ Символы.ПС
		+ "2. Рекомендации технологу"
		+ Символы.ПС
		+ "3. Возможные риски"
		+ Символы.ПС
		+ "4. Меры снижения брака"
		+ "Отправь ответ без разметки md";
	
	ОтветИИ =
		ОтправитьЗапрос(Текст);
	
	СохранитьРекомендацию(
		Номенклатура,
		"Брак",
		Текст,
		ОтветИИ
	);
	
	Возврат ОтветИИ;
	
КонецФункции

Функция ПолучитьАнализСебестоимости(
	Номенклатура,
	Себестоимость,
	Рентабельность,
	ИндексБрака
) Экспорт
	
	Текст =
		"Проанализируй себестоимость молочной продукции."
		+ Символы.ПС
		+ Символы.ПС
		+ "Продукция: "
		+ Номенклатура.Наименование
		+ Символы.ПС
		+ "Себестоимость: "
		+ Формат(Себестоимость, "ЧГ=0.00")
		+ " руб."
		+ Символы.ПС
		+ "Рентабельность: "
		+ Формат(Рентабельность, "ЧГ=0.00")
		+ "%"
		+ Символы.ПС
		+ "Индекс влияния брака: "
		+ Формат(ИндексБрака, "ЧГ=0.00")
		+ "%"
		+ Символы.ПС
		+ Символы.ПС
		+ "Дай:"
		+ Символы.ПС
		+ "1. Оценку структуры затрат"
		+ Символы.ПС
		+ "2. Возможные резервы снижения себестоимости"
		+ Символы.ПС
		+ "3. Оценку влияния брака"
		+ Символы.ПС
		+ "4. Рекомендации по повышению рентабельности"
		+ "Отправь ответ без разметки md";
	
	ОтветИИ =
		ОтправитьЗапрос(Текст);
	
	СохранитьРекомендацию(
		Номенклатура,
		"Себестоимость",
		Текст,
		ОтветИИ
	);
	
	Возврат ОтветИИ;
	
КонецФункции

Процедура СохранитьРекомендацию(
	Номенклатура,
	ТипАнализа,
	ВходныеДанные,
	ТекстРекомендации
) Экспорт
	
	Набор =
		РегистрыСведений.РекомендацииИИ
		.СоздатьНаборЗаписей();
	
	Запись = Набор.Добавить();
	
	Запись.Период =
		ТекущаяДата();
	
	Запись.Номенклатура =
		Номенклатура;
	
	Запись.ТипАнализа =
		ТипАнализа;
	
	Запись.ТекстРекомендации =
		ТекстРекомендации;
	
	Запись.ВходныеДанные =
		ВходныеДанные;
	
	Запись.ВремяОтветаСек =
		0;
	
	Набор.Записать();
	
КонецПроцедуры

