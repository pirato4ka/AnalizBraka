Функция ПолучитьАтрибутыНоменклатуры(Номенклатура) Экспорт
	
	Результат = Новый Структура(
		"ЕдиницаИзмерения, СрокГодностиДней, НормаЖирности,
		|НормаКислотности, НормаВыходаПроцент, НормаБракаПроцент,
		|КоэффВозвратаОтходов, ЦенаРеализации"
	);
	
	Если Номенклатура.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Ном.СрокГодностиДней КАК СрокГодностиДней,
	|	Ном.НормаЖирности КАК НормаЖирности,
	|	Ном.НормаКислотности КАК НормаКислотности,
	|	Ном.НормаВыходаПроцент КАК НормаВыходаПроцент,
	|	Ном.НормаБракаПроцент КАК НормаБракаПроцент
	|ИЗ
	|	Справочник.НоменклатураМолочнойПродукции КАК Ном
	|ГДЕ
	|	Ном.Ссылка = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	ВыборкаНом = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаНом.Следующий() Тогда
		Результат.ЕдиницаИзмерения   = ВыборкаНом.ЕдиницаИзмерения;
		Результат.СрокГодностиДней   = ВыборкаНом.СрокГодностиДней;
		Результат.НормаЖирности      = ВыборкаНом.НормаЖирности;
		Результат.НормаКислотности   = ВыборкаНом.НормаКислотности;
		Результат.НормаВыходаПроцент = ВыборкаНом.НормаВыходаПроцент;
		Результат.НормаБракаПроцент  = ВыборкаНом.НормаБракаПроцент;
	КонецЕсли;
	
	НормыСрез = РегистрыСведений.НормыПроизводства.ПолучитьПоследнее(
		ТекущаяДата(),
		Новый Структура("Номенклатура", Номенклатура)
	);
	
	Если ЗначениеЗаполнено(НормыСрез.КоэффВозвратаОтходов) Тогда
		Результат.КоэффВозвратаОтходов = НормыСрез.КоэффВозвратаОтходов;
	Иначе
		Результат.КоэффВозвратаОтходов =
			ПолучитьКоэффВозвратаПоУмолчанию(Номенклатура);
	КонецЕсли;
	
	ЦенаСрез = РегистрыСведений.ЦеныНоменклатуры.ПолучитьПоследнее(
		ТекущаяДата(),
		Новый Структура("Номенклатура", Номенклатура)
	);
	
	Результат.ЦенаРеализации = ЦенаСрез.ЦенаРеализации;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКоэффВозвратаПоУмолчанию(Номенклатура) Экспорт
    
    ТипПродукции = Номенклатура.Тип;
    
    НаименованиеТипа = "";
    Если ЗначениеЗаполнено(ТипПродукции) Тогда
        НаименованиеТипа = НРег(СокрЛП(ТипПродукции.Метаданные().Имя));
    КонецЕсли;
    
    Если НаименованиеТипа = "творог" Тогда
        Возврат 0.35;
    ИначеЕсли НаименованиеТипа = "сыр" Тогда
        Возврат 0.30;
    ИначеЕсли НаименованиеТипа = "масло" Тогда
        Возврат 0.25;
    ИначеЕсли НаименованиеТипа = "сметана" Тогда
        Возврат 0.20;
    ИначеЕсли НаименованиеТипа = "кефир" Тогда
        Возврат 0.15;
    Иначе
        Возврат 0.10;
    КонецЕсли;
    
КонецФункции

Функция ПолучитьТарифВидаРабот(ВидРаботы, Дата) Экспорт
	
	ТарифСрез = РегистрыСведений.ТарифыВидовРабот.ПолучитьПоследнее(
		Дата,
		Новый Структура("ВидРаботы", ВидРаботы)
	);
	
	Возврат ТарифСрез.СтоимостьЧаса;
	
КонецФункции

Функция СписатьМатериалыFIFO(
	Номенклатура,
	Склад,
	НужноКоличество,
	Дата
) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.СрокГодности КАК СрокГодности,
	|	Остатки.ДокументПартии КАК ДокументПартии,
	|	Остатки.НомерПартии КАК НомерПартии,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток,
	|	Остатки.СтоимостьОстаток КАК СтоимостьОстаток
	|ИЗ
	|	РегистрНакопления.СкладскиеОстатки.Остатки(
	|		&МоментВремени,
	|		Номенклатура = &Номенклатура
	|			И Склад = &Склад
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.СрокГодности ВОЗР";
	
	Запрос.УстановитьПараметр(
		"МоментВремени",
		Новый МоментВремени(Дата)
	);
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОсталосьСписать = НужноКоличество;
	
	Пока Выборка.Следующий()
		И ОсталосьСписать > 0 Цикл
		
		СписываемКол =
			Мин(ОсталосьСписать, Выборка.КоличествоОстаток);
		
		ЦенаЗаЕд = 0;
		Если Выборка.КоличествоОстаток > 0 Тогда
			ЦенаЗаЕд =
				Выборка.СтоимостьОстаток
				/ Выборка.КоличествоОстаток;
		КонецЕсли;
		
		ЗаписьПартии = Новый Структура;
		ЗаписьПартии.Вставить("СрокГодности",  Выборка.СрокГодности);
		ЗаписьПартии.Вставить("ДокументПартии", Выборка.ДокументПартии);
		ЗаписьПартии.Вставить("НомерПартии",    Выборка.НомерПартии);
		ЗаписьПартии.Вставить("Количество",     СписываемКол);
		ЗаписьПартии.Вставить("Стоимость",      Окр(СписываемКол * ЦенаЗаЕд, 2));
		
		Результат.Добавить(ЗаписьПартии);
		
		ОсталосьСписать = ОсталосьСписать - СписываемКол;
		
	КонецЦикла;
	
	Если ОсталосьСписать > 0 Тогда
		ЗаписьОшибки = Новый Структура;
		ЗаписьОшибки.Вставить("Ошибка", Истина);
		ЗаписьОшибки.Вставить("НедостатокКоличество", ОсталосьСписать);
		Результат.Добавить(ЗаписьОшибки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДостаточностьОстатков(
	Номенклатура,
	Склад,
	НужноКоличество,
	Дата
) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(Остатки.КоличествоОстаток),
	|		0
	|	) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.СкладскиеОстатки.Остатки(
	|		&МоментВремени,
	|		Номенклатура = &Номенклатура
	|			И Склад = &Склад
	|	) КАК Остатки";
	
	Запрос.УстановитьПараметр(
		"МоментВремени",
		Новый МоментВремени(Дата)
	);
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КоличествоОстаток >= НужноКоличество;
	
КонецФункции

Функция ПолучитьПроцентБракаЗаПериод(
	Номенклатура,
	ДатаНачала,
	ДатаКонца
) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Брак.КоличествоБракОборот), 0)
	|		КАК КолБрак,
	|	ЕСТЬNULL(СУММА(Брак.КоличествоВыпускОборот), 0)
	|		КАК КолВыпуск
	|ИЗ
	|	РегистрНакопления.БракПроизводства.Обороты(
	|		&ДатаНачала,
	|		&ДатаКонца,
	|		,
	|		Номенклатура = &Номенклатура
	|	) КАК Брак";
	
	Запрос.УстановитьПараметр("ДатаНачала",   ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца",    ДатаКонца);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если Выборка.КолВыпуск = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Окр(
		Выборка.КолБрак / Выборка.КолВыпуск * 100,
		3
	);
	
КонецФункции

Процедура ДобавитьОшибку(Отказ, ТекстОшибки, ИмяПоля = "") Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	
	Если Не ПустаяСтрока(ИмяПоля) Тогда
		Сообщение.Поле = ИмяПоля;
	КонецЕсли;
	
	Сообщение.Сообщить();
	Отказ = Истина;
	
КонецПроцедуры