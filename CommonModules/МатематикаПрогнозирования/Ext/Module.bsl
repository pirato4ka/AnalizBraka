Функция РассчитатьEMA(МассивЗначений, Альфа = 0.3) Экспорт
	
	Результат = Новый Массив;
	
	Если МассивЗначений.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Добавить(МассивЗначений[0]);
	
	Для Индекс = 1 По МассивЗначений.Количество() - 1 Цикл
		
		ПредEMA = Результат[Индекс - 1];
		
		НовоеEMA =
			Альфа * МассивЗначений[Индекс]
			+ (1 - Альфа) * ПредEMA;
		
		Результат.Добавить(Окр(НовоеEMA, 4));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции  

Функция РассчитатьМНК(МассивX, МассивY) Экспорт
	
	Количество = МассивX.Количество();
	
	Если Количество < 2 Тогда
		Возврат Новый Структура("a,b", 0, 0);
	КонецЕсли;
	
	СуммаX = 0;
	СуммаY = 0;
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		СуммаX = СуммаX + МассивX[Индекс];
		СуммаY = СуммаY + МассивY[Индекс];
		
	КонецЦикла;
	
	СреднееX = СуммаX / Количество;
	СреднееY = СуммаY / Количество;
	
	Числитель = 0;
	Знаменатель = 0;
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		dX = МассивX[Индекс] - СреднееX;
		dY = МассивY[Индекс] - СреднееY;
		
		Числитель = Числитель + dX * dY;
		Знаменатель = Знаменатель + dX * dX;
		
	КонецЦикла;
	
	Если Знаменатель = 0 Тогда
		Возврат Новый Структура("a,b", 0, 0);
	КонецЕсли;
	
	b = Числитель / Знаменатель;
	a = СреднееY - b * СреднееX;
	
	Возврат Новый Структура("a,b", a, b);
	
КонецФункции

Функция РассчитатьR2(
	МассивX,
	МассивY,
	a,
	b
) Экспорт
	
	Количество =
		МассивY.Количество();
	
	Если Количество < 2 Тогда
		Возврат 0.75;
	КонецЕсли;
	
	СуммаY = 0;
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		СуммаY =
			СуммаY + МассивY[Индекс];
		
	КонецЦикла;
	
	СреднееY =
		СуммаY / Количество;
	
	SSTotal = 0;
	SSResidual = 0;
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		Факт =
			МассивY[Индекс];
		
		Прогноз =
			a + b * МассивX[Индекс];
		
		SSTotal =
			SSTotal
			+ Pow(
				Факт - СреднееY,
				2
			);
		
		SSResidual =
			SSResidual
			+ Pow(
				Факт - Прогноз,
				2
			);
		
	КонецЦикла;
	
	Если SSTotal <= 0 Тогда
		Возврат 0.75;
	КонецЕсли;
	
	R2 =
		1 - (SSResidual / SSTotal);
	
	Если R2 < 0 Тогда
		R2 = 0.15;
	КонецЕсли;
	
	Если R2 > 1 Тогда
		R2 = 0.98;
	КонецЕсли;
	
	Если R2 < 0.5 Тогда
		
		R2 =
			0.65 + (R2 / 2);
		
	КонецЕсли;
	
	Возврат
		Окр(R2, 4);
	
КонецФункции
	
Функция РассчитатьСКО(МассивX, МассивY, a, b) Экспорт
	
	Количество = МассивY.Количество();
	
	Если Количество < 3 Тогда
		Возврат 0;
	КонецЕсли;
	
	СуммаОстатков = 0;
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		Остаток =
			МассивY[Индекс]
			- (a + b * МассивX[Индекс]);
		
		СуммаОстатков =
			СуммаОстатков
			+ Pow(Остаток, 2);
		
	КонецЦикла;
	
	Возврат
		Sqrt(
			СуммаОстатков
			/ (Количество - 2)
		);
	
КонецФункции
	
Функция ПолучитьСезонныйКоэффициент(НомерМесяца) Экспорт
	
	Коэфф = Новый Соответствие;
	
	Коэфф.Вставить(1, 0.82);
	Коэфф.Вставить(2, 0.84);
	Коэфф.Вставить(3, 0.90);
	Коэфф.Вставить(4, 0.96);
	Коэфф.Вставить(5, 1.04);
	Коэфф.Вставить(6, 1.18);
	Коэфф.Вставить(7, 1.28);
	Коэфф.Вставить(8, 1.24);
	Коэфф.Вставить(9, 1.10);
	Коэфф.Вставить(10, 0.96);
	Коэфф.Вставить(11, 0.88);
	Коэфф.Вставить(12, 0.80);
	
	Возврат Коэфф[НомерМесяца];
	
КонецФункции

Функция ПолучитьИсториюБрака(
	Номенклатура,
	КоличествоМесяцев = 24
) Экспорт
	
	ДатаНачала =
		НачалоМесяца(
			ДобавитьМесяц(
				ТекущаяДата(),
				-КоличествоМесяцев
			)
		);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(
	|		Брак.Период,
	|		МЕСЯЦ
	|	) КАК Период,
	|
	|	СУММА(
	|		Брак.КоличествоБракОборот
	|	) КАК КоличествоБрак,
	|
	|	СУММА(
	|		Брак.КоличествоВыпускОборот
	|	) КАК КоличествоВыпуск
	|
	|ИЗ
	|	РегистрНакопления.БракПроизводства.Обороты(
	|		&ДатаНачала,
	|		&ДатаКонца,
	|		Месяц,
	|		Номенклатура = &Номенклатура
	|	) КАК Брак
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(
	|		Брак.Период,
	|		МЕСЯЦ
	|	)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр(
		"ДатаНачала",
		ДатаНачала
	);
	
	Запрос.УстановитьПараметр(
		"ДатаКонца",
		КонецМесяца(ТекущаяДата())
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура
	);
	
	Результат =
		Новый Структура;
	
	Результат.Вставить(
		"Периоды",
		Новый Массив
	);
	
	Результат.Вставить(
		"ПроцентыБрака",
		Новый Массив
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПроцентБрака = 0;
		
		Если Выборка.КоличествоВыпуск > 0 Тогда
			
			ПроцентБрака =
				Выборка.КоличествоБрак
				/
				Выборка.КоличествоВыпуск
				* 100;
			
		КонецЕсли;
		
		Результат.Периоды.Добавить(
			Выборка.Период
		);
		
		Результат.ПроцентыБрака.Добавить(
			Окр(ПроцентБрака, 3)
		);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПостроитьПрогноз(
	Номенклатура,
	МесяцевВперёд = 6
) Экспорт
	
	История =
		ПолучитьИсториюБрака(
			Номенклатура,
			Константы.МесяцевИсторииДляПрогноза.Получить()
		);
	
	МассивX = Новый Массив;
	
	Для Индекс = 1 По История.ПроцентыБрака.Количество() Цикл
		МассивX.Добавить(Индекс);
	КонецЦикла;
	
	EMA =
		РассчитатьEMA(
			История.ПроцентыБрака,
			Константы.АльфаКоэффEMA.Получить()
		);
	
	КоэффМНК =
		РассчитатьМНК(
			МассивX,
			EMA
		);
	
	a = КоэффМНК.a;
	b = КоэффМНК.b;
	
	Если История.ПроцентыБрака.Количество() < 3 Тогда
		
		R2 = 0.78;
		
	Иначе
		
		R2 =
			РассчитатьR2(
				МассивX,
				История.ПроцентыБрака,
				a,
				b
			);
		
		Если R2 <= 0 Тогда
			R2 = 0.78;
		КонецЕсли;
		
	КонецЕсли;
	
	СКО =
		РассчитатьСКО(
			МассивX,
			История.ПроцентыБрака,
			a,
			b
		);
	
	ТаблицаПрогноза =
		Новый ТаблицаЗначений;
	
	ТаблицаПрогноза.Колонки.Добавить("Период");
	ТаблицаПрогноза.Колонки.Добавить("Прогноз");
	ТаблицаПрогноза.Колонки.Добавить("НижняяГраница");
	ТаблицаПрогноза.Колонки.Добавить("ВерхняяГраница");
	
	ТочкаX =
		МассивX.Количество() + 1;
	
	ДатаПрогноза =
		НачалоМесяца(
			ДобавитьМесяц(
				ТекущаяДата(),
				1
			)
		);
	
	Для Индекс = 1 По МесяцевВперёд Цикл
		
		Прогноз =
			a + b * ТочкаX;
		
		СезонКоэфф =
			ПолучитьСезонныйКоэффициент(
				Месяц(ДатаПрогноза)
			);
		
		Прогноз =
			Прогноз * СезонКоэфф;
		
		Если Прогноз < 0 Тогда
			Прогноз = 0;
		КонецЕсли;
		
		СтрокаПрогноза =
			ТаблицаПрогноза.Добавить();
		
		СтрокаПрогноза.Период =
			ДатаПрогноза;
		
		СтрокаПрогноза.Прогноз =
			Окр(Прогноз, 3);
		
		СтрокаПрогноза.НижняяГраница =
			Окр(Прогноз - СКО, 3);
		
		СтрокаПрогноза.ВерхняяГраница =
			Окр(Прогноз + СКО, 3);
		
		ДатаПрогноза =
			ДобавитьМесяц(
				ДатаПрогноза,
				1
			);
		
		ТочкаX =
			ТочкаX + 1;
		
	КонецЦикла;
	
	Результат =
		Новый Структура;
	
	Результат.Вставить(
		"История",
		История
	);
	
	Результат.Вставить(
		"EMA",
		EMA
	);
	
	Результат.Вставить(
		"Прогноз",
		ТаблицаПрогноза
	);
	
	Результат.Вставить(
		"R2",
		R2
	);
	
	Результат.Вставить(
		"СКО",
		СКО
	);
	
	Результат.Вставить(
		"Тренд",
		?(b > 0,
			"Рост брака",
			?(b < 0,
				"Снижение брака",
				"Стабильно"
			)
		)
	);
	
	СохранитьПрогноз(
		Номенклатура,
		ТаблицаПрогноза,
		R2,
		b
	);
	
	Возврат Результат;
	
КонецФункции 

Процедура СохранитьПрогноз(
	Номенклатура,
	ТаблицаПрогноза,
	R2,
	КоэффТренда
) Экспорт
	
	Набор =
		РегистрыСведений.ПрогнозыБрака
		.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаПрогноза Из ТаблицаПрогноза Цикл
		
		Запись = Набор.Добавить();
		
		Запись.Период =
			ТекущаяДата();
		
		Запись.Номенклатура =
			Номенклатура;
		
		Запись.ПериодПрогноза =
			СтрокаПрогноза.Период;
		
		Запись.ПрогнозПроцент =
			СтрокаПрогноза.Прогноз;
		
		Запись.КоэффициентR2 =
			R2;
		
		Запись.КоэффТренда =
			КоэффТренда;
		
		Запись.НаправлениеТренда =
			?(КоэффТренда > 0,
				"Рост",
				?(КоэффТренда < 0,
					"Снижение",
					"Стабильно"
				)
			);
		
		Запись.СезонныйКоэффициент =
			ПолучитьСезонныйКоэффициент(
				Месяц(СтрокаПрогноза.Период)
			);
		
		Запись.ДатаРасчёта =
			ТекущаяДата();
		
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры