Функция ПолучитьУровеньРиска(
	ПроцентБрака,
	R2
) Экспорт
	
	Если R2 < 0.4 Тогда
		Возврат "Недостаточно данных";
	КонецЕсли;
	
	Если ПроцентБрака > 7 Тогда
		Возврат "Критический";
	КонецЕсли;
	
	Если ПроцентБрака > 5 Тогда
		Возврат "Высокий";
	КонецЕсли;
	
	Если ПроцентБрака > 3 Тогда
		Возврат "Средний";
	КонецЕсли;
	
	Возврат "Низкий";
	
КонецФункции