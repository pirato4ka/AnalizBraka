Функция ВыполнитьВсеТесты() Экспорт

    Результат = Новый ТаблицаЗначений;

    Результат.Колонки.Добавить("Тест");
    Результат.Колонки.Добавить("Статус");
    Результат.Колонки.Добавить("Комментарий");

    ДобавитьРезультат(
        Результат,
        "EMA начальное значение",
        ТестEMAНачальноеЗначение());

    ДобавитьРезультат(
        Результат,
        "EMA два значения",
        ТестEMAДваЗначения());

    ДобавитьРезультат(
        Результат,
        "МНК коэффициент b",
        ТестМНК());

    ДобавитьРезультат(
        Результат,
        "Сезонный коэффициент июль",
        ТестСезонныйКоэффициент());

    ДобавитьРезультат(
        Результат,
        "R2 диапазон",
        ТестR2());

    ДобавитьРезультат(
        Результат,
        "СКО для малого массива",
        ТестСКО());

    ДобавитьРезультат(
        Результат,
        "Уровень риска Низкий",
        ТестРискНизкий());

    ДобавитьРезультат(
        Результат,
        "Уровень риска Средний",
        ТестРискСредний());

    ДобавитьРезультат(
        Результат,
        "Уровень риска Критический",
        ТестРискКритический());

    ДобавитьРезультат(
        Результат,
        "Недостаточно данных",
        ТестНедостаточноДанных());

    Возврат Результат;

КонецФункции

Процедура ДобавитьРезультат(
    Таблица,
    ИмяТеста,
    РезультатТеста)

    НоваяСтрока =
        Таблица.Добавить();

    НоваяСтрока.Тест =
        ИмяТеста;

    Если РезультатТеста Тогда

        НоваяСтрока.Статус =
            "Пройден";

        НоваяСтрока.Комментарий =
            "";

    Иначе

        НоваяСтрока.Статус =
            "Ошибка";

        НоваяСтрока.Комментарий =
            "Ожидаемый результат не получен";

    КонецЕсли;

КонецПроцедуры

Функция ТестEMAНачальноеЗначение() Экспорт

    Массив =
        Новый Массив;

    Массив.Добавить(4);

    Результат =
        МатематикаПрогнозирования
        .РассчитатьEMA(
            Массив,
            0.3);

    Возврат Результат[0] = 4;

КонецФункции

Функция ТестEMAДваЗначения() Экспорт

    Массив =
        Новый Массив;

    Массив.Добавить(4);
    Массив.Добавить(6);

    Результат =
        МатематикаПрогнозирования
        .РассчитатьEMA(
            Массив,
            0.3);

    Возврат
        Результат[1] = 4.6;

КонецФункции

Функция ТестМНК() Экспорт

    X =
        Новый Массив;

    Y =
        Новый Массив;

    X.Добавить(1);
    X.Добавить(2);
    X.Добавить(3);

    Y.Добавить(2);
    Y.Добавить(4);
    Y.Добавить(6);

    Результат =
        МатематикаПрогнозирования
        .РассчитатьМНК(X, Y);

    Возврат
        Окр(Результат.b, 2) = 2;

КонецФункции

Функция ТестСезонныйКоэффициент() Экспорт

    Коэфф =
        МатематикаПрогнозирования
        .ПолучитьСезонныйКоэффициент(
            7);

    Возврат Коэфф = 1.28;

КонецФункции

Функция ТестR2() Экспорт

    X = Новый Массив;
    Y = Новый Массив;

    X.Добавить(1);
    X.Добавить(2);
    X.Добавить(3);

    Y.Добавить(2);
    Y.Добавить(4);
    Y.Добавить(6);

    R2 =
        МатематикаПрогнозирования
        .РассчитатьR2(
            X,
            Y,
            0,
            2);

    Возврат
        R2 >= 0.9;
КонецФункции

Функция ТестСКО() Экспорт

    X = Новый Массив;
    Y = Новый Массив;

    X.Добавить(1);
    X.Добавить(2);

    Y.Добавить(2);
    Y.Добавить(4);

    СКО =
        МатематикаПрогнозирования
        .РассчитатьСКО(
            X,
            Y,
            0,
            2);

    Возврат СКО = 0;

КонецФункции

