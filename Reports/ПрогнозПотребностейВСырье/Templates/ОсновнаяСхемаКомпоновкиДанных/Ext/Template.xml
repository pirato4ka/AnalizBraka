		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Остатки.Номенклатура КАК Номенклатура,
	ОКР(ЕСТЬNULL(Остатки.КоличествоКонечныйОстаток, 0), 3) КАК ТекущийОстаток,
	ОКР(ЕСТЬNULL(Расход.СреднийРасход, 0), 3) КАК СреднийРасход,
	ОКР(ЕСТЬNULL(Расход.СреднийРасход, 0) * ЕСТЬNULL(Прогноз.СезонныйКоэфф, 1), 3) КАК ПрогнозПотребности,
	ВЫБОР
		КОГДА ОКР(ЕСТЬNULL(Остатки.КоличествоКонечныйОстаток, 0), 3) &lt; ОКР(ЕСТЬNULL(Расход.СреднийРасход, 0), 3) * ОКР(ЕСТЬNULL(Прогноз.СезонныйКоэфф, 1), 3)
			ТОГДА "Требуется закупка"
		ИНАЧЕ "Остатков достаточно"
	КОНЕЦ КАК Статус,
	Остатки.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения
ИЗ
	(ВЫБРАТЬ
		Ост.Номенклатура КАК Номенклатура,
		СУММА(Ост.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток
	ИЗ
		РегистрНакопления.СкладскиеОстатки.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК Ост
	ГДЕ
		Ост.Номенклатура.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыМолочнойПродукции.Сырье), ЗНАЧЕНИЕ(Перечисление.ТипыМолочнойПродукции.Упаковка))
		И Ост.Склад = &amp;Склад
	
	СГРУППИРОВАТЬ ПО
		Ост.Номенклатура) КАК Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Мат.Номенклатура КАК Номенклатура,
			СРЕДНЕЕ(Мат.Количество) КАК СреднийРасход
		ИЗ
			Документ.ЭтапПроизводства.Материалы КАК Мат
		
		СГРУППИРОВАТЬ ПО
			Мат.Номенклатура) КАК Расход
		ПО Остатки.Номенклатура = Расход.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Пр.Номенклатура КАК Номенклатура,
			МАКСИМУМ(Пр.СезонныйКоэффициент) КАК СезонныйКоэфф
		ИЗ
			РегистрСведений.ПрогнозыБрака КАК Пр
		
		СГРУППИРОВАТЬ ПО
			Пр.Номенклатура) КАК Прогноз
		ПО Остатки.Номенклатура = Прогноз.Номенклатура

УПОРЯДОЧИТЬ ПО
	Статус,
	Номенклатура</query>
