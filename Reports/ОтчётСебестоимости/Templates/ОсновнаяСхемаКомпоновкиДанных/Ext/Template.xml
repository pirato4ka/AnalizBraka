		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Себ.Номенклатура КАК Номенклатура,
	Себ.Цех КАК Цех,
	Себ.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	СУММА(Себ.СтоимостьСырьяОборот) КАК СтоимостьСырья,
	СУММА(Себ.СтоимостьТрудаОборот) КАК СтоимостьТруда,
	СУММА(Себ.НакладныеРасходыОборот) КАК НакладныеРасходы,
	СУММА(Себ.СтоимостьБракаОборот) КАК СтоимостьБрака,
	СУММА(Себ.СтоимостьУпаковкиОборот) КАК СтоимостьУпаковки,
	СУММА(Себ.КоличествоВыпускОборот) КАК КоличествоВыпуск,
	СУММА(Себ.КоличествоБракОборот) КАК КоличествоБрак,
	СУММА(Себ.СтоимостьСырьяОборот + Себ.СтоимостьТрудаОборот + Себ.НакладныеРасходыОборот + Себ.СтоимостьБракаОборот + Себ.СтоимостьУпаковкиОборот) КАК ПолнаяСебестоимость,
	ВЫБОР
		КОГДА СУММА(Себ.КоличествоВыпускОборот) = 0
			ТОГДА 0
		ИНАЧЕ ОКР(СУММА(Себ.СтоимостьСырьяОборот + Себ.СтоимостьТрудаОборот + Себ.НакладныеРасходыОборот + Себ.СтоимостьБракаОборот + Себ.СтоимостьУпаковкиОборот) / СУММА(Себ.КоличествоВыпускОборот), 2)
	КОНЕЦ КАК СебестоимостьЕдиницы,
	ВЫБОР
		КОГДА ОКР(СУММА(Себ.СтоимостьСырьяОборот + Себ.СтоимостьТрудаОборот + Себ.НакладныеРасходыОборот + Себ.СтоимостьБракаОборот + Себ.СтоимостьУпаковкиОборот), 2) = 0
			ТОГДА 0
		ИНАЧЕ ОКР(СУММА(Себ.СтоимостьБракаОборот) / СУММА(Себ.СтоимостьСырьяОборот + Себ.СтоимостьТрудаОборот + Себ.НакладныеРасходыОборот + Себ.СтоимостьБракаОборот + Себ.СтоимостьУпаковкиОборот), 2) * 100
	КОНЕЦ КАК ИндексБрака,
	Себ.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения
ИЗ
	РегистрНакопления.СебестоимостьВыпуска.Обороты(&amp;ДатаНачала, &amp;ДатаОкончания, , ) КАК Себ
ГДЕ
	Себ.Номенклатура = &amp;Номенклатура

СГРУППИРОВАТЬ ПО
	Себ.Номенклатура,
	Себ.Цех,
	Себ.ЗаказНаПроизводство,
	Себ.Номенклатура.ЕдиницаИзмерения.Наименование

УПОРЯДОЧИТЬ ПО
	Номенклатура</query>
