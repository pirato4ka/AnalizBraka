		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Брак.Номенклатура КАК Номенклатура,
	Брак.Цех КАК Цех,
	Брак.Бригада КАК Бригада,
	Брак.ПричинаБрака КАК ПричинаБрака,
	ОКР(СУММА(Брак.КоличествоБракОборот),2) КАК КоличествоБрак,
	ОКР(СУММА(Брак.КоличествоВыпускОборот),2) КАК КоличествоВыпуск,
	ОКР(СУММА(Брак.СтоимостьБракаОборот),2) КАК СтоимостьБрака,
	ВЫБОР
		КОГДА СУММА(Брак.КоличествоВыпускОборот) = 0
			ТОГДА 0
		ИНАЧЕ ОКР((СУММА(Брак.КоличествоБракОборот) / СУММА(Брак.КоличествоВыпускОборот) * 100), 2)
	КОНЕЦ КАК ПроцентБрака
ИЗ
	РегистрНакопления.БракПроизводства.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК Брак
ГДЕ 
	Номенклатура = &amp;Номенклатура И Цех = &amp;Цех

СГРУППИРОВАТЬ ПО
	Брак.Номенклатура,
	Брак.Цех,
	Брак.Бригада,
	Брак.ПричинаБрака

УПОРЯДОЧИТЬ ПО
	Номенклатура</query>
