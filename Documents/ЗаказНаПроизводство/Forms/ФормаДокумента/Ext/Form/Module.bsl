&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	ЗаполнитьПоНоменклатуреСервер();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоНоменклатуреСервер()
	
	Если Объект.Номенклатура.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	НомАтрибуты = ОбщиеФункцииМолочногоПроизводства.ПолучитьАтрибутыНоменклатуры(
		Объект.Номенклатура
	);
	
	Объект.ЕдиницаИзмерения = НомАтрибуты.ЕдиницаИзмерения;
	
	ПодобратьСпецификациюСервер();
	
КонецПроцедуры

&НаСервере
Процедура ПодобратьСпецификациюСервер()
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Спец.Ссылка КАК Спецификация
    |ИЗ
    |    Справочник.СпецификацииРецептуры КАК Спец
    |ГДЕ
    |    Спец.ВыходноеИзделие = &Номенклатура
    |    И Спец.Статус = &Статус
    |    И Спец.ПометкаУдаления = ЛОЖЬ
    |УПОРЯДОЧИТЬ ПО
    |    Спец.ДатаУтверждения УБЫВ";
    
    Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
    Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыСпецификаций.Активная);
    
    РезЗапроса = Запрос.Выполнить();
    Если Не РезЗапроса.Пустой() Тогда
        Выборка = РезЗапроса.Выбрать();
        Выборка.Следующий();
        Объект.Спецификация = Выборка.Спецификация;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЭтапыПроизводства(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, "Сначала запишите документ", 10);
		Возврат;
	КонецЕсли;
	
	Если Объект.Спецификация.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, "Не указана спецификация", 10);
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("СформироватьЭтапыПодтверждение", ЭтотОбъект),
		"Сформировать этапы производства по спецификации?",
		РежимДиалогаВопрос.ДаНет
	);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЭтапыПодтверждение(Результат, ДопПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	КолСформировано = СформироватьЭтапыСервер();
	ПоказатьПредупреждение(
		Неопределено,
		"Сформировано этапов производства: " + КолСформировано,
		10
	);
	
КонецПроцедуры

&НаСервере
Функция СформироватьЭтапыСервер()
	
	СпецОбъект = Объект.Спецификация.ПолучитьОбъект();
	
	ЭтапыИзСпецификации = Новый СписокЗначений;
	Для Каждого СтрМат Из СпецОбъект.Материалы Цикл
		Если ЭтапыИзСпецификации.НайтиПоЗначению(СтрМат.ЭтапПроизводства) = Неопределено Тогда
			ЭтапыИзСпецификации.Добавить(СтрМат.ЭтапПроизводства);
		КонецЕсли;
	КонецЦикла;
	
	КолСформировано = 0;
	
	Для Каждого ЭлЭтап Из ЭтапыИзСпецификации Цикл
		
		НовыйЭтап = Документы.ЭтапПроизводства.СоздатьДокумент();
		НовыйЭтап.Дата                = ТекущаяДата();
		НовыйЭтап.ЗаказНаПроизводство = Объект.Ссылка;
		НовыйЭтап.Номенклатура        = Объект.Номенклатура;
		НовыйЭтап.КоличествоПлан      = Объект.Количество;
		НовыйЭтап.ЕдиницаИзмерения    = Объект.ЕдиницаИзмерения;
		НовыйЭтап.Цех                  = Объект.Цех;
		НовыйЭтап.ЭтапПроизводства    = ЭлЭтап.Значение;
		НовыйЭтап.Статус = Перечисления.СтатусыЭтаповПроизводства.Запланирован;
		
		Для Каждого СтрМат Из СпецОбъект.Материалы Цикл
			Если СтрМат.ЭтапПроизводства = ЭлЭтап.Значение Тогда
				НоваяСтрМат = НовыйЭтап.Материалы.Добавить();
				НоваяСтрМат.Номенклатура     = СтрМат.Номенклатура;
				НоваяСтрМат.Количество       = СтрМат.Количество * Объект.Количество;
				НоваяСтрМат.ЕдиницаИзмерения = СтрМат.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрТруд Из СпецОбъект.Трудозатраты Цикл
			НоваяСтрТруд = НовыйЭтап.Трудозатраты.Добавить();
			НоваяСтрТруд.ВидРаботы        = СтрТруд.ВидРаботы;
			НоваяСтрТруд.КоличествоЧасов  = СтрТруд.НормаВремениЧас;
			НоваяСтрТруд.СтоимостьЧаса    = ОбщиеФункцииМолочногоПроизводства
				.ПолучитьТарифВидаРабот(СтрТруд.ВидРаботы, ТекущаяДата());
			НоваяСтрТруд.Сумма = НоваяСтрТруд.КоличествоЧасов * НоваяСтрТруд.СтоимостьЧаса;
		КонецЦикла;
		
		НовыйЭтап.Записать(РежимЗаписиДокумента.Запись);
		КолСформировано = КолСформировано + 1;
		
	КонецЦикла;
	
	Возврат КолСформировано;
	
КонецФункции