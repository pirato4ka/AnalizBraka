&НаКлиенте
Процедура ЭтапПроизводстваПриИзменении(Элемент)
	ЗаполнитьПоЭтапуСервер();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоЭтапуСервер()
	
	Если Объект.ЭтапПроизводства.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапОбъект =
		Объект.ЭтапПроизводства.ПолучитьОбъект();
	
	Объект.ЗаказНаПроизводство =
		ЭтапОбъект.ЗаказНаПроизводство;
	
	Объект.Номенклатура =
		ЭтапОбъект.Номенклатура;
	
	Объект.ЕдиницаИзмерения =
		ЭтапОбъект.ЕдиницаИзмерения;
	
	Нормы =
		ОбщиеФункцииМолочногоПроизводства
		.ПолучитьАтрибутыНоменклатуры(
			Объект.Номенклатура
		);
	
	Объект.НормаЖирность =
		Нормы.НормаЖирности;
	
	Объект.НормаКислотность =
		Нормы.НормаКислотности;
	
	Объект.КоэффВозвратаОтходов =
		Нормы.КоэффВозвратаОтходов;
	
	РассчитатьСтоимостьБракаСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффВозвратаОтходовПриИзменении(Элемент)
	РассчитатьСтоимостьБракаСервер();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоБракПриИзменении(Элемент)
	
	РассчитатьСтоимостьБракаСервер();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСтоимостьБракаСервер()
	
	Если Объект.КоличествоБрак <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтоимостьЕдиницы =
		ПолучитьСтоимостьЕдиницыСервер();
	
	Объект.СтоимостьБрака =
		Окр(
			Объект.КоличествоБрак
			* СтоимостьЕдиницы
			* (1 - Объект.КоэффВозвратаОтходов),
			2
		);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтоимостьЕдиницыСервер()
	
	Если Объект.ЗаказНаПроизводство.Пустая() Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(
	|			Себ.СтоимостьСырьяОборот
	|			+ Себ.СтоимостьТрудаОборот
	|			+ Себ.НакладныеРасходыОборот
	|			+ Себ.СтоимостьУпаковкиОборот
	|		),
	|		0
	|	) КАК Стоимость,
	|
	|	ЕСТЬNULL(
	|		СУММА(
	|			Себ.КоличествоВыпускОборот
	|		),
	|		0
	|	) КАК Количество
	|
	|ИЗ
	|	РегистрНакопления.СебестоимостьВыпуска.Обороты(
	|		,
	|		,
	|		,
	|		ЗаказНаПроизводство = &Заказ
	|			И Номенклатура = &Номенклатура
	|	) КАК Себ";
	
	Запрос.УстановитьПараметр(
		"Заказ",
		Объект.ЗаказНаПроизводство
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Объект.Номенклатура
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Выборка.Количество = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат
		Выборка.Стоимость
		/
		Выборка.Количество;
	
КонецФункции

&НаКлиенте
Процедура ФактЖирностьПриИзменении(Элемент)
	РассчитатьОтклонения();
КонецПроцедуры

&НаКлиенте
Процедура ФактКислотностьПриИзменении(Элемент)
	РассчитатьОтклонения();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОтклонения()
	
	Объект.ОтклонениеЖирность =
		Объект.ФактЖирность
		- Объект.НормаЖирность;
	
	Объект.ОтклонениеКислотность =
		Объект.ФактКислотность
		- Объект.НормаКислотность;
	
КонецПроцедуры