Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если КоличествоБрак <= 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Количество брака должно быть больше нуля";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Движения.БракПроизводства.Записывать = Истина;
	Движения.СебестоимостьВыпуска.Записывать = Истина;
	
	ОтклонениеЖирность =
		ФактЖирность - НормаЖирность;
	
	ОтклонениеКислотность =
		ФактКислотность - НормаКислотность;
	
	СтоимостьЕдиницы =
		ПолучитьСебестоимостьЕдиницы();
	
	СтоимостьБрака =
		КоличествоБрак
		* СтоимостьЕдиницы
		* (1 - КоэффВозвратаОтходов);
	
	КоличествоВыпущено =
		ПолучитьКоличествоВыпуска();
	
	ЦехДокумента =
		ПолучитьЦехЭтапа();
	
	БригадаДокумента =
		ПолучитьБригадуЭтапа();
	
	ДвижениеБрак =
		Движения.БракПроизводства.Добавить();
	
	ДвижениеБрак.Период = Дата;
	ДвижениеБрак.Номенклатура = Номенклатура;
	ДвижениеБрак.Цех = ЦехДокумента;
	ДвижениеБрак.Бригада = БригадаДокумента;
	ДвижениеБрак.ПричинаБрака = ПричинаБрака;
	
	ДвижениеБрак.ЗаказНаПроизводство =
		ЗаказНаПроизводство;
	
	ДвижениеБрак.КоличествоБрак =
		КоличествоБрак;
	
	ДвижениеБрак.КоличествоВыпуск =
		КоличествоВыпущено;
	
	ДвижениеБрак.СтоимостьБрака =
		СтоимостьБрака;
	
	ДвижениеСеб =
		Движения.СебестоимостьВыпуска.Добавить();
	
	ДвижениеСеб.Период = Дата;
	ДвижениеСеб.Номенклатура = Номенклатура;
	
	ДвижениеСеб.ЗаказНаПроизводство =
		ЗаказНаПроизводство;
	
	ДвижениеСеб.Цех =
		ЦехДокумента;
	
	ДвижениеСеб.СтоимостьСырья = 0;
	ДвижениеСеб.СтоимостьТруда = 0;
	ДвижениеСеб.НакладныеРасходы = 0;
	
	ДвижениеСеб.СтоимостьБрака =
		СтоимостьБрака;
	
	ДвижениеСеб.СтоимостьУпаковки = 0;
	ДвижениеСеб.КоличествоВыпуск = 0;
	
	ДвижениеСеб.КоличествоБрак =
		КоличествоБрак;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Движения.БракПроизводства.Записывать = Истина;
	Движения.СебестоимостьВыпуска.Записывать = Истина;
	
	Движения.БракПроизводства.Очистить();
	Движения.СебестоимостьВыпуска.Очистить();
	
КонецПроцедуры

Функция ПолучитьСебестоимостьЕдиницы()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(
	|			Себ.СтоимостьСырьяОборот
	|			+ Себ.СтоимостьТрудаОборот
	|			+ Себ.НакладныеРасходыОборот
	|			+ Себ.СтоимостьУпаковкиОборот
	|		),
	|		0
	|	) КАК ОбщаяСтоимость,
	|
	|	ЕСТЬNULL(
	|		СУММА(
	|			Себ.КоличествоВыпускОборот
	|		),
	|		0
	|	) КАК КоличествоВыпуск
	|
	|ИЗ
	|	РегистрНакопления.СебестоимостьВыпуска.Обороты(
	|		,
	|		,
	|		,
	|		ЗаказНаПроизводство = &Заказ
	|			И Номенклатура = &Номенклатура
	|	) КАК Себ";
	
	Запрос.УстановитьПараметр(
		"Заказ",
		ЗаказНаПроизводство
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Выборка.КоличествоВыпуск = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат
		Выборка.ОбщаяСтоимость
		/
		Выборка.КоличествоВыпуск;
	
КонецФункции

Функция ПолучитьКоличествоВыпуска()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(
	|			Выпуск.КоличествоОборот
	|		),
	|		0
	|	) КАК Количество
	|
	|ИЗ
	|	РегистрНакопления.ВыпускПродукции.Обороты(
	|		,
	|		,
	|		,
	|		ЗаказНаПроизводство = &Заказ
	|			И Номенклатура = &Номенклатура
	|	) КАК Выпуск";
	
	Запрос.УстановитьПараметр(
		"Заказ",
		ЗаказНаПроизводство
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

Функция ПолучитьЦехЭтапа()
	
	Если ЭтапПроизводства.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЭтапПроизводства.Цех;
	
КонецФункции

Функция ПолучитьБригадуЭтапа()
	
	Если ЭтапПроизводства.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЭтапПроизводства.Бригада;
	
КонецФункции