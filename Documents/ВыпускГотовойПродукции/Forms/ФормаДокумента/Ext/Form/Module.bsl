&НаКлиенте
Процедура ЭтапПроизводстваПриИзменении(Элемент)
	ЗаполнитьПоЭтапуСервер();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоЭтапуСервер()
	
	Если Объект.ЭтапПроизводства.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапОбъект =
		Объект.ЭтапПроизводства.ПолучитьОбъект();
	
	Объект.ЗаказНаПроизводство =
		ЭтапОбъект.ЗаказНаПроизводство;
	
	Объект.Номенклатура =
		ЭтапОбъект.Номенклатура;
	
	Объект.КоличествоФакт =
		ЭтапОбъект.КоличествоФакт;
	
	Объект.ЕдиницаИзмерения =
		ЭтапОбъект.ЕдиницаИзмерения;
	
	НомАтрибуты =
		ОбщиеФункцииМолочногоПроизводства
		.ПолучитьАтрибутыНоменклатуры(
			Объект.Номенклатура
		);
	
	Если НомАтрибуты.СрокГодностиДней > 0 Тогда
		
		Объект.СрокГодности =
			НачалоДня(Объект.Дата)
			+ НомАтрибуты.СрокГодностиДней * 86400;
		
	КонецЕсли;
	
	РассчитатьСебестоимостьСервер();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСебестоимостьСервер()
	
	Если Объект.ЗаказНаПроизводство.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(
	|		Себ.СтоимостьСырьяОборот
	|		+ Себ.СтоимостьТрудаОборот
	|		+ Себ.НакладныеРасходыОборот
	|		+ Себ.СтоимостьБракаОборот
	|		+ Себ.СтоимостьУпаковкиОборот
	|	) КАК ОбщаяСебестоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьВыпуска.Обороты(
	|		,
	|		,
	|		,
	|		ЗаказНаПроизводство = &Заказ
	|			И Номенклатура = &Номенклатура
	|	) КАК Себ";
	
	Запрос.УстановитьПараметр(
		"Заказ",
		Объект.ЗаказНаПроизводство
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Объект.Номенклатура
	);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Объект.ОбщаяСебестоимость =
			Выборка.ОбщаяСебестоимость;
			
	Иначе
		
		Объект.ОбщаяСебестоимость = 0;
		
	КонецЕсли;
	
	Если Объект.КоличествоФакт > 0 Тогда
		
		Объект.СебестоимостьЕдиницы =
			Объект.ОбщаяСебестоимость
			/ Объект.КоличествоФакт;
		
	Иначе
		
		Объект.СебестоимостьЕдиницы = 0;
		
	КонецЕсли;
	
КонецПроцедуры