Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если КоличествоФакт <= 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Количество выпуска должно быть больше нуля";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Если Склад.Пустая() Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан склад выпуска";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Движения.СкладскиеОстатки.Записывать = Истина;
	Движения.ВыпускПродукции.Записывать = Истина;
	
	ОбщаяСебестоимость =
		ПолучитьСебестоимостьВыпуска();
	
	Если КоличествоФакт > 0 Тогда
		СебестоимостьЕдиницы =
			ОбщаяСебестоимость / КоличествоФакт;
	Иначе
		СебестоимостьЕдиницы = 0;
	КонецЕсли;
	
	НомерПартии =
		Формат(Дата, "ДФ=yyyyMMdd")
		+ "-"
		+ Номер;
	
	ДвижениеСклад = Движения.СкладскиеОстатки.Добавить();
	ДвижениеСклад.ВидДвижения = ВидДвиженияНакопления.Приход;
	ДвижениеСклад.Период = Дата;
	ДвижениеСклад.Номенклатура = Номенклатура;
	ДвижениеСклад.Склад = Склад;
	ДвижениеСклад.СрокГодности = СрокГодности;
	ДвижениеСклад.ДокументПартии = Ссылка;
	ДвижениеСклад.Количество = КоличествоФакт;
	ДвижениеСклад.Стоимость = ОбщаяСебестоимость;
	ДвижениеСклад.НомерПартии = НомерПартии;
	ДвижениеСклад.ЕдиницаИзмерения = ЕдиницаИзмерения;
	
	ДвижениеВыпуск = Движения.ВыпускПродукции.Добавить();
	ДвижениеВыпуск.ВидДвижения = ВидДвиженияНакопления.Приход;
	ДвижениеВыпуск.Период = Дата;
	ДвижениеВыпуск.Номенклатура = Номенклатура;
	ДвижениеВыпуск.Цех = ПолучитьЦех();
	ДвижениеВыпуск.Склад = Склад;
	ДвижениеВыпуск.ЗаказНаПроизводство = ЗаказНаПроизводство;
	ДвижениеВыпуск.Количество = КоличествоФакт;
	ДвижениеВыпуск.Стоимость = ОбщаяСебестоимость;
	ДвижениеВыпуск.СрокГодности = СрокГодности;
	ДвижениеВыпуск.ЕдиницаИзмерения = ЕдиницаИзмерения;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Движения.СкладскиеОстатки.Записывать = Истина;
	Движения.ВыпускПродукции.Записывать = Истина;
	
	Движения.СкладскиеОстатки.Очистить();
	Движения.ВыпускПродукции.Очистить();
	
КонецПроцедуры

Функция ПолучитьСебестоимостьВыпуска()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(
	|		Себ.СтоимостьСырьяОборот
	|		+ Себ.СтоимостьТрудаОборот
	|		+ Себ.НакладныеРасходыОборот
	|		+ Себ.СтоимостьБракаОборот
	|		+ Себ.СтоимостьУпаковкиОборот
	|	) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьВыпуска.Обороты(
	|		,
	|		,
	|		,
	|		ЗаказНаПроизводство = &Заказ
	|			И Номенклатура = &Номенклатура
	|	) КАК Себ";
	
	Запрос.УстановитьПараметр(
		"Заказ",
		ЗаказНаПроизводство
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	Возврат
		Выборка.Себестоимость;
	
КонецФункции

Функция ПолучитьЦех()
	
	Если ЭтапПроизводства.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЭтапПроизводства.Цех;
	
КонецФункции