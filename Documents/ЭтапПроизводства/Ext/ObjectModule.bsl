Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Статус <> Перечисления.СтатусыЭтаповПроизводства.Завершён Тогда
		Возврат;
	КонецЕсли;
	
	Движения.СкладскиеОстатки.Записывать = Истина;
	Движения.ТрудозатратыПроизводства.Записывать = Истина;
	Движения.СебестоимостьВыпуска.Записывать = Истина;
	
	ОбщаяСтоимостьМатериалов = 0;
	ОбщаяСтоимостьТруда = 0;
	
	Для Каждого СтрМат Из Материалы Цикл
		
		Если НЕ ОбщиеФункцииМолочногоПроизводства.ПроверитьДостаточностьОстатков(
			СтрМат.Номенклатура,
			СкладМатериалов,
			СтрМат.Количество,
			Дата
		) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Недостаточно остатка: "
				+ СтрМат.Номенклатура;
			Сообщение.Сообщить();
			
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		МассивFIFO =
			ОбщиеФункцииМолочногоПроизводства.СписатьМатериалыFIFO(
				СтрМат.Номенклатура,
				СкладМатериалов,
				СтрМат.Количество,
				Дата
			);
			
		ОбщаяСтоимостьУпаковки = 0;	
			
		Для Каждого Партия Из МассивFIFO Цикл
			
			Если Партия.Свойство("Ошибка") Тогда
				Продолжить;
			КонецЕсли;
			
			Движение =
				Движения.СкладскиеОстатки.Добавить();
			
			Движение.ВидДвижения =
				ВидДвиженияНакопления.Расход;
			
			Движение.Период = Дата;
			Движение.Номенклатура = СтрМат.Номенклатура;
			Движение.Склад = СкладМатериалов;
			Движение.СрокГодности = Партия.СрокГодности;
			Движение.ДокументПартии = Партия.ДокументПартии;
			Движение.НомерПартии = Партия.НомерПартии;
			Движение.Количество = Партия.Количество;
			Движение.Стоимость = Партия.Стоимость;
			Движение.ЕдиницаИзмерения =
				СтрМат.ЕдиницаИзмерения;
			
			Если СтрМат.Номенклатура.Тип =
				Перечисления.ТипыМолочнойПродукции.Упаковка
			Тогда
				
				ОбщаяСтоимостьУпаковки =
					ОбщаяСтоимостьУпаковки
					+ Партия.Стоимость;
				
			Иначе
				
				ОбщаяСтоимостьМатериалов =
					ОбщаяСтоимостьМатериалов
					+ Партия.Стоимость;
				
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрТруд Из Трудозатраты Цикл
		
		СуммаТруда =
			СтрТруд.КоличествоЧасов
			* СтрТруд.СтоимостьЧаса;
		
		ДвижениеТруд =
			Движения.ТрудозатратыПроизводства.Добавить();
		
		ДвижениеТруд.Период = Дата;
		ДвижениеТруд.ЗаказНаПроизводство =
			ЗаказНаПроизводство;
		
		ДвижениеТруд.ВидРаботы =
			СтрТруд.ВидРаботы;
		
		ДвижениеТруд.Бригада =
			Бригада;
		
		ДвижениеТруд.Цех =
			Цех;
		
		ДвижениеТруд.КоличествоЧасов =
			СтрТруд.КоличествоЧасов;
		
		ДвижениеТруд.Сумма =
			СуммаТруда;
		
		ОбщаяСтоимостьТруда =
			ОбщаяСтоимостьТруда
			+ СуммаТруда;
		
	КонецЦикла;
	
	КоэффНакладных =
		Константы.КоэффНакладныхРасходовПроцент
		.Получить();
	
	НакладныеРасходы =
		ОбщаяСтоимостьМатериалов
		* КоэффНакладных
		/ 100;
	
	ДвижениеСеб =
		Движения.СебестоимостьВыпуска.Добавить();
	
	ДвижениеСеб.Период = Дата;
	ДвижениеСеб.Номенклатура = Номенклатура;
	ДвижениеСеб.ЗаказНаПроизводство =
		ЗаказНаПроизводство;
	
	ДвижениеСеб.Цех = Цех;
	
	ДвижениеСеб.СтоимостьСырья =
		ОбщаяСтоимостьМатериалов;
	
	ДвижениеСеб.СтоимостьТруда =
		ОбщаяСтоимостьТруда;
	
	ДвижениеСеб.НакладныеРасходы =
		НакладныеРасходы;
	
	ДвижениеСеб.СтоимостьБрака = 0;
	
	ДвижениеСеб.СтоимостьУпаковки =
	ОбщаяСтоимостьУпаковки;
	
	ДвижениеСеб.КоличествоВыпуск =
		КоличествоФакт;
	
	ДвижениеСеб.КоличествоБрак = 0;
	
	Если НЕ СкладВыпуска.Пустая() Тогда
		
		СебестоимостьЕд = 0;
		
		Если КоличествоФакт > 0 Тогда
			
			СебестоимостьЕд =
				(
					ОбщаяСтоимостьМатериалов
					+ ОбщаяСтоимостьТруда
					+ НакладныеРасходы
				)
				/ КоличествоФакт;
			
		КонецЕсли;
		
		НомАтрибуты =
			ОбщиеФункцииМолочногоПроизводства
			.ПолучитьАтрибутыНоменклатуры(
				Номенклатура
			);
		
		ДвижениеВыпуск =
			Движения.СкладскиеОстатки.Добавить();
		
		ДвижениеВыпуск.ВидДвижения =
			ВидДвиженияНакопления.Приход;
		
		ДвижениеВыпуск.Период = Дата;
		ДвижениеВыпуск.Номенклатура = Номенклатура;
		ДвижениеВыпуск.Склад = СкладВыпуска;
		
		ДвижениеВыпуск.СрокГодности =
			НачалоДня(Дата)
			+ НомАтрибуты.СрокГодностиДней * 86400;
		
		ДвижениеВыпуск.ДокументПартии =
			Ссылка;
		
		ДвижениеВыпуск.НомерПартии =
			Формат(Дата, "ДФ=yyyyMMdd")
			+ "-"
			+ Номер;
		
		ДвижениеВыпуск.Количество =
			КоличествоФакт;
		
		ДвижениеВыпуск.Стоимость =
			СебестоимостьЕд
			* КоличествоФакт;
		
		ДвижениеВыпуск.ЕдиницаИзмерения =
			ЕдиницаИзмерения;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Движения.СкладскиеОстатки.Записывать = Истина;
	Движения.ТрудозатратыПроизводства.Записывать = Истина;
	Движения.СебестоимостьВыпуска.Записывать = Истина;
	
	Движения.СкладскиеОстатки.Очистить();
	Движения.ТрудозатратыПроизводства.Очистить();
	Движения.СебестоимостьВыпуска.Очистить();
	
КонецПроцедуры