&НаКлиенте
Процедура ТрудозатратыВидРаботыПриИзменении(Элемент)
    
    СтрокаТаблицы = Элементы.Трудозатраты.ТекущиеДанные;
    
    Если СтрокаТаблицы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьСтоимостьЧаса(СтрокаТаблицы);
    
КонецПроцедуры

&НаКлиенте
Процедура ТрудозатратыКоличествоЧасовПриИзменении(Элемент)
    
    СтрокаТаблицы = Элементы.Трудозатраты.ТекущиеДанные;
    
    Если СтрокаТаблицы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    СтрокаТаблицы.Сумма = СтрокаТаблицы.КоличествоЧасов * СтрокаТаблицы.СтоимостьЧаса;
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтоимостьЧаса(СтрокаТаблицы)
    
    Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидРаботы) Тогда
        СтрокаТаблицы.СтоимостьЧаса = 0;
        СтрокаТаблицы.Сумма = 0;
        Возврат;
    КонецЕсли;
    
    СтоимостьЧаса = ПолучитьСтоимостьЧасаСервер(
        СтрокаТаблицы.ВидРаботы,
        Объект.Дата
    );
    
    СтрокаТаблицы.СтоимостьЧаса = СтоимостьЧаса;
    СтрокаТаблицы.Сумма = СтрокаТаблицы.КоличествоЧасов * СтоимостьЧаса;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтоимостьЧасаСервер(ВидРаботы, Дата)
    
    СтоимостьЧаса = 0;
    
    ОтборРегистра = Новый Структура;
    ОтборРегистра.Вставить("ВидРаботы", ВидРаботы);
    
    ДанныеРегистра = РегистрыСведений.ТарифыВидовРабот.ПолучитьПоследнее(
        Дата,
        ОтборРегистра
    );
    
    Если ДанныеРегистра <> Неопределено Тогда
        СтоимостьЧаса = ДанныеРегистра.СтоимостьЧаса;
    КонецЕсли;
    
    Возврат СтоимостьЧаса;
    
КонецФункции