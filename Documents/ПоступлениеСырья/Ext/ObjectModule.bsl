Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.СкладскиеОстатки.Записывать = Истина;
	
	Для Каждого Строка Из Материалы Цикл
		
		Если Строка.Количество <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Строка " + Строка.НомерСтроки + ": количество должно быть больше нуля";
			Сообщение.Поле = "Материалы[" + (Строка.НомерСтроки - 1) + "].Количество";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Строка.Цена <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Строка " + Строка.НомерСтроки + ": цена должна быть больше нуля";
			Сообщение.Поле = "Материалы[" + (Строка.НомерСтроки - 1) + "].Цена";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Строка.СрокГодности = Дата(1,1,1) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Строка " + Строка.НомерСтроки + ": не указан срок годности";
			Сообщение.Поле = "Материалы[" + (Строка.НомерСтроки - 1) + "].СрокГодности";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.СкладскиеОстатки.Добавить();
		Движение.ВидДвижения   = ВидДвиженияНакопления.Приход;
		Движение.Период        = Дата;
		Движение.Номенклатура  = Строка.Номенклатура;
		Движение.Склад         = Склад;
		Движение.СрокГодности  = Строка.СрокГодности;
		Движение.ДокументПартии = Ссылка;
		Движение.Количество    = Строка.Количество;
		Движение.Стоимость     = Строка.Количество * Строка.Цена;
		Движение.НомерПартии   = Строка.НомерПартии;
		Движение.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьКачественныеПоказатели();
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Движения.СкладскиеОстатки.Записывать = Истина;
	Движения.СкладскиеОстатки.Очистить();
КонецПроцедуры

Процедура ЗаписатьКачественныеПоказатели()
	
	Для Каждого Строка Из Материалы Цикл
		
		Если Строка.ФактЖирность = 0 И Строка.ФактКислотность = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.КачественныеПоказателиСырья.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Строка.Номенклатура);
		НаборЗаписей.Отбор.ДокументПартии.Установить(Ссылка);
		
		ЗаписьРегистра = НаборЗаписей.Добавить();
		ЗаписьРегистра.Период          = Дата;
		ЗаписьРегистра.Номенклатура    = Строка.Номенклатура;
		ЗаписьРегистра.ДокументПартии  = Ссылка;
		ЗаписьРегистра.ФактЖирность    = Строка.ФактЖирность;
		ЗаписьРегистра.ФактКислотность = Строка.ФактКислотность;
		ЗаписьРегистра.НомерПартии     = Строка.НомерПартии;
		ЗаписьРегистра.Поставщик       = Поставщик;
		ЗаписьРегистра.СрокГодности    = Строка.СрокГодности;
		
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры