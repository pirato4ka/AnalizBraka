&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	
	 СтрокаТЧ = Элементы.Материалы.ТекущиеДанные;
    Если СтрокаТЧ = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ИндексСтроки = Объект.Материалы.Индекс(СтрокаТЧ);
    ЗаполнитьСтрокуПоНоменклатуреСервер(ИндексСтроки);
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьСтрокуПоНоменклатуреСервер(ИндексСтроки)
    
    СтрокаТЧ = Объект.Материалы[ИндексСтроки];
    
    Если СтрокаТЧ = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
        Возврат;
    КонецЕсли;
    
    НомАтрибуты = ОбщиеФункцииМолочногоПроизводства.ПолучитьАтрибутыНоменклатуры(
        СтрокаТЧ.Номенклатура
    );
    
    СтрокаТЧ.ЕдиницаИзмерения = НомАтрибуты.ЕдиницаИзмерения;
    
    СрокГодностиДней = НомАтрибуты.СрокГодностиДней;
    Если СрокГодностиДней > 0 Тогда
        СтрокаТЧ.СрокГодности = НачалоДня(Объект.Дата) + СрокГодностиДней * 86400;
    КонецЕсли;
    
    НормыСрез = РегистрыСведений.НормыПроизводства.ПолучитьПоследнее(
        Объект.Дата,
        Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура)
    );
    
    Если НормыСрез <> Неопределено Тогда
        СтрокаТЧ.НормаЖирности    = НормыСрез.НормаЖирности;
        СтрокаТЧ.НормаКислотности = НормыСрез.НормаКислотности;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	РассчитатьСуммуСтроки();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	РассчитатьСуммуСтроки();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки()
	
	СтрокаТЧ = Элементы.Материалы.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыФактЖирностьПриИзменении(Элемент)
	ПроверитьОтклоненияКачества();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыФактКислотностьПриИзменении(Элемент)
	ПроверитьОтклоненияКачества();
КонецПроцедуры

 &НаКлиенте
Процедура ПроверитьОтклоненияКачества()
	
	СтрокаТЧ = Элементы.Материалы.ТекущиеДанные;
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПредупреждения = "";
	
	Если СтрокаТЧ.НормаЖирности > 0 Тогда
		РазницаЖир = СтрокаТЧ.ФактЖирность - СтрокаТЧ.НормаЖирности;
		ОтклонениеЖир = ?(РазницаЖир < 0, -РазницаЖир, РазницаЖир);
		Если ОтклонениеЖир > 0.5 Тогда
			ТекстПредупреждения = ТекстПредупреждения
				+ "Отклонение жирности: " + ОтклонениеЖир + "%" + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаТЧ.НормаКислотности > 0 Тогда
		РазницаКисл = СтрокаТЧ.ФактКислотность - СтрокаТЧ.НормаКислотности;
		ОтклонениеКисл = ?(РазницаКисл < 0, -РазницаКисл, РазницаКисл);
		Если ОтклонениеКисл > 2 Тогда
			ТекстПредупреждения = ТекстПредупреждения
				+ "Отклонение кислотности: " + ОтклонениеКисл + "°Т" + Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстПредупреждения) Тогда
		ПоказатьПредупреждение(
			Неопределено,
			"Обнаружены отклонения качества сырья:" + Символы.ПС + ТекстПредупреждения,
			15,
			"Контроль качества"
		);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКоэффВозвратаПоУмолчанию(Номенклатура) Экспорт
	
	ТипПродукции = Номенклатура.Тип;
	
	НаименованиеТипа = "";
	Если ЗначениеЗаполнено(ТипПродукции) Тогда
		НаименованиеТипа = НРег(СокрЛП(ТипПродукции.Наименование));
	КонецЕсли;
	
	Если НаименованиеТипа = "творог" Тогда
		Возврат 0.35;
	ИначеЕсли НаименованиеТипа = "сыр" Тогда
		Возврат 0.30;
	ИначеЕсли НаименованиеТипа = "масло" Тогда
		Возврат 0.25;
	ИначеЕсли НаименованиеТипа = "сметана" Тогда
		Возврат 0.20;
	ИначеЕсли НаименованиеТипа = "кефир" Тогда
		Возврат 0.15;
	Иначе
		Возврат 0.10;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	Если Объект.Склад.Пустая() Тогда
		Возврат;
	КонецЕсли;
КонецПроцедуры