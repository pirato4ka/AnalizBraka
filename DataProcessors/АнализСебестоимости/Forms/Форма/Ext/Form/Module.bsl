&НаКлиенте
Процедура СформироватьАнализ( Команда)
	
	Если Номенклатура.Пустая() Тогда
		
		ПоказатьПредупреждение(
			Неопределено,
			"Не выбрана номенклатура",
			5
		);
		
		Возврат;
		
	ИначеЕсли ДатаНачала = Дата(1,1,1) Тогда
		  ПоказатьПредупреждение(
			Неопределено,
			"Не выбрана дата начала",
			5
		);
	    Возврат;
		
	ИначеЕсли ДатаНачала = Дата(1,1,1) Тогда
		  ПоказатьПредупреждение(
			Неопределено,
			"Не выбрана дата конца",
			5
		);
	    Возврат;
		
	КонецЕсли;
	
	СформироватьАнализСервер();
	
	ОбновитьЦветИндекса();
	
КонецПроцедуры                 

&НаКлиенте
Процедура ОбновитьЦветИндекса()
	
	Если ИндексБрака > 40 Тогда
		
		Элементы.ИндексБрака.ЦветТекста =
			WebЦвета.Красный;
		
	ИначеЕсли ИндексБрака > 20 Тогда
		
		Элементы.ИндексБрака.ЦветТекста =
			WebЦвета.Оранжевый;
		
	Иначе
		
		Элементы.ИндексБрака.ЦветТекста =
			WebЦвета.Зеленый;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьАнализСервер()
	
	Результат =
		РассчитатьСебестоимость();
	
	СтоимостьСырья =
		Результат.СтоимостьСырья;
	
	СтоимостьТруда =
		Результат.СтоимостьТруда;
	
	НакладныеРасходы =
		Результат.НакладныеРасходы;
	
	СтоимостьБрака =
		Результат.СтоимостьБрака;
	
	СтоимостьУпаковки =
		Результат.СтоимостьУпаковки;
	
	Себестоимость =
		Результат.Себестоимость;
	
	Рентабельность =
		Результат.Рентабельность;
	
	ИндексБрака =
		Результат.ИндексБрака;
	
	ВыходПродукта =
		Результат.ВыходПродукта;
	
	ТаблицаСтруктурыЗатрат.Очистить();

	Для Каждого Стр Из Результат.ТаблицаСтруктуры Цикл
		
		НоваяСтрока =
			ТаблицаСтруктурыЗатрат.Добавить();
		
		НоваяСтрока.Статья =
			Стр.Статья;
		
		НоваяСтрока.Сумма =
			Стр.Сумма;
		
		НоваяСтрока.Доля =
			Стр.Доля;
		
	КонецЦикла;
	
	ТекстАнализаИИ =
		РаботаСYandexGPT
		.ПолучитьАнализСебестоимости(
			Номенклатура,
			Себестоимость,
			Рентабельность,
			ИндексБрака
		);
	
	
КонецПроцедуры           

&НаСервере
Функция РассчитатьСебестоимость()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Себ.СтоимостьСырьяОборот)
	|		КАК СтоимостьСырья,
	|
	|	СУММА(Себ.СтоимостьТрудаОборот)
	|		КАК СтоимостьТруда,
	|
	|	СУММА(Себ.НакладныеРасходыОборот)
	|		КАК НакладныеРасходы,
	|
	|	СУММА(Себ.СтоимостьБракаОборот)
	|		КАК СтоимостьБрака,
	|
	|	СУММА(Себ.СтоимостьУпаковкиОборот)
	|		КАК СтоимостьУпаковки,
	|
	|	СУММА(Себ.КоличествоВыпускОборот)
	|		КАК КоличествоВыпуск,
	|
	|	СУММА(Себ.КоличествоБракОборот)
	|		КАК КоличествоБрак
	|
	|ИЗ
	|	РегистрНакопления.СебестоимостьВыпуска.Обороты(
	|		&ДатаНачала,
	|		&ДатаОкончания,
	|		,
	|		Номенклатура = &Номенклатура
	|	) КАК Себ";
	
	Запрос.УстановитьПараметр(
		"ДатаНачала",
		ДатаНачала
	);
	
	Запрос.УстановитьПараметр(
		"ДатаОкончания",
		КонецДня(ДатаОкончания)
	);
	
	Запрос.УстановитьПараметр(
		"Номенклатура",
		Номенклатура
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	СтоимостьСырья =
		Выборка.СтоимостьСырья;
	
	СтоимостьТруда =
		Выборка.СтоимостьТруда;
	
	НакладныеРасходы =
		Выборка.НакладныеРасходы;
	
	СтоимостьБрака =
		Выборка.СтоимостьБрака;
	
	СтоимостьУпаковки =
		Выборка.СтоимостьУпаковки;
	
	КоличествоВыпуск =
	?(ТипЗнч(Выборка.КоличествоВыпуск)
		= Тип("Число"),
		Выборка.КоличествоВыпуск,
		0);
	
	КоличествоБрак =
	?(ТипЗнч(Выборка.КоличествоБрак)
		= Тип("Число"),
		Выборка.КоличествоБрак,
		0);
	
	ПолнаяСебестоимость =
		СтоимостьСырья
		+ СтоимостьТруда
		+ НакладныеРасходы
		+ СтоимостьБрака
		+ СтоимостьУпаковки;
	
	СебестоимостьЕдиницы = 0;
	
	Если КоличествоВыпуск > 0 Тогда
		
		СебестоимостьЕдиницы =
			ПолнаяСебестоимость
			/
			КоличествоВыпуск;
		
	КонецЕсли;
	
	Цена =
		ПолучитьЦенуРеализации();
	
	Рентабельность = 0;
	
	Если Цена > 0 Тогда
		
		Рентабельность =
			(
				Цена
				- СебестоимостьЕдиницы
			)
			/
			Цена
			* 100;
		
	КонецЕсли;
	
	ИндексБрака = 0;
	
	Если ПолнаяСебестоимость > 0 Тогда
		
		ИндексБрака =
			СтоимостьБрака
			/
			ПолнаяСебестоимость
			* 100;
		
	КонецЕсли;
	
	ВыходПродукта =
	100 - ИндексБрака;
	
	Таблица =
		Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("Статья");
	Таблица.Колонки.Добавить("Сумма");
	Таблица.Колонки.Добавить("Доля");
	
	ДобавитьСтрокуСтруктуры(
		Таблица,
		"Сырьё",
		СтоимостьСырья,
		ПолнаяСебестоимость
	);
	
	ДобавитьСтрокуСтруктуры(
		Таблица,
		"Труд",
		СтоимостьТруда,
		ПолнаяСебестоимость
	);
	
	ДобавитьСтрокуСтруктуры(
		Таблица,
		"Накладные",
		НакладныеРасходы,
		ПолнаяСебестоимость
	);
	
	ДобавитьСтрокуСтруктуры(
		Таблица,
		"Брак",
		СтоимостьБрака,
		ПолнаяСебестоимость
	);
	
	ДобавитьСтрокуСтруктуры(
		Таблица,
		"Упаковка",
		СтоимостьУпаковки,
		ПолнаяСебестоимость
	);
	
	Результат = Новый Структура;
	
	Результат.Вставить(
		"СтоимостьСырья",
		Окр(СтоимостьСырья, 2)
	);
	
	Результат.Вставить(
		"СтоимостьТруда",
		Окр(СтоимостьТруда, 2)
	);
	
	Результат.Вставить(
		"НакладныеРасходы",
		Окр(НакладныеРасходы, 2)
	);
	
	Результат.Вставить(
		"СтоимостьБрака",
		Окр(СтоимостьБрака, 2)
	);
	
	Результат.Вставить(
		"СтоимостьУпаковки",
		Окр(СтоимостьУпаковки, 2)
	);
	
	Результат.Вставить(
		"Себестоимость",
		Окр(ПолнаяСебестоимость, 2)
	);
	
	Результат.Вставить(
		"СебестоимостьЕдиницы",
		Окр(СебестоимостьЕдиницы, 2)
	);
	
	Результат.Вставить(
		"Рентабельность",
		Окр(Рентабельность, 2)
	);
	
	Результат.Вставить(
		"ИндексБрака",
		Окр(ИндексБрака, 2)
	);
	
	Результат.Вставить(
		"ВыходПродукта",
		Окр(ВыходПродукта, 2)
	);
	
	Результат.Вставить(
		"ТаблицаСтруктуры",
		Таблица
	);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуСтруктуры(
	Таблица,
	Статья,
	Сумма,
	ОбщаяСумма
)
	
	Строка =
		Таблица.Добавить();
	
	Строка.Статья =
		Статья;
	
	Строка.Сумма =
		Окр(Сумма, 2);
	
	Если ОбщаяСумма > 0 Тогда
		
		Строка.Доля =
			Окр(
				Сумма
				/ ОбщаяСумма
				* 100,
				2
			);
		
	Иначе
		
		Строка.Доля = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуРеализации()
	
	Срез =
		РегистрыСведений.ЦеныНоменклатуры
		.ПолучитьПоследнее(
			ДатаОкончания,
			Новый Структура(
				"Номенклатура",
				Номенклатура
			)
		);
	
	Возврат Срез.ЦенаРеализации;
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоСырья()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(
	|			Труд.КоличествоЧасовОборот
	|		),
	|		0
	|	) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТрудозатратыПроизводства.Обороты(
	|		&ДатаНачала,
	|		&ДатаОкончания
	|	) КАК Труд";
	
	Запрос.УстановитьПараметр(
		"ДатаНачала",
		ДатаНачала
	);
	
	Запрос.УстановитьПараметр(
		"ДатаОкончания",
		ДатаОкончания
	);
	
	Выборка =
		Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

