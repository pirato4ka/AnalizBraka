&НаКлиенте
Процедура СформироватьПрогноз(Команда)
	
	СформироватьПрогнозСервер();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПрогнозСервер()
	
	Если Номенклатура.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрана номенклатура";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если МесяцевПрогноза <= 0 Тогда
		МесяцевПрогноза = 3;
	КонецЕсли;
	
	Результат =
		МатематикаПрогнозирования
		.ПостроитьПрогноз(
			Номенклатура,
			МесяцевПрогноза
		);
	
	ТаблицаПрогноза.Очистить();
	
	Для Каждого Стр Из Результат.Прогноз Цикл
		
		НоваяСтрока =
			ТаблицаПрогноза.Добавить();
		
		НоваяСтрока.Период =
			Стр.Период;
		
		НоваяСтрока.Прогноз =
			Стр.Прогноз;
		
		НоваяСтрока.НижняяГраница =
			Стр.НижняяГраница;
		
		НоваяСтрока.ВерхняяГраница =
			Стр.ВерхняяГраница;
		
	КонецЦикла;
	
	ПроцентУверенности =
		Окр(Результат.R2 * 100, 2);
		
	Если ПроцентУверенности <= 0 Тогда
	
	ПроцентУверенности =
		Окр(Результат.R2 * 100, 2);
		
	КонецЕсли;
	
	Тренд =
		Результат.Тренд;
	
	Если ТаблицаПрогноза.Количество() > 0 Тогда
	
	ПервыйПрогноз =
		ТаблицаПрогноза[0].Прогноз;
	
	Если ПроцентУверенности >= 80 Тогда
		
		УровеньРиска =
			АналитикаРисков
			.ПолучитьУровеньРиска(
				ПервыйПрогноз,
				ПроцентУверенности / 100
			);
		
	Иначе
		
		УровеньРиска =
			"Средний";
		
	КонецЕсли;
	
	Иначе
		
		УровеньРиска =
			"Недостаточно данных";
		
	КонецЕсли;
	
	Попытка
		
		ТекстРекомендаций =
			РаботаСYandexGPT
			.ПолучитьРекомендацииПоБраку(
				Номенклатура,
				Результат
			);
		
	Исключение
		
		ТекстРекомендаций =
			"Ошибка получения рекомендаций ИИ: "
			+ ОписаниеОшибки();
		
	КонецПопытки;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если УровеньРиска = "Высокий" Тогда
		Элементы.УровеньРиска.ЦветФона =
			WebЦвета.Красный;
	
	ИначеЕсли УровеньРиска = "Средний" Тогда
		Элементы.УровеньРиска.ЦветФона =
			WebЦвета.Желтый;
	
	Иначе
		
		Элементы.УровеньРиска.ЦветФона =
			WebЦвета.Зеленый;
	
	КонецЕсли;
	
КонецПроцедуры
